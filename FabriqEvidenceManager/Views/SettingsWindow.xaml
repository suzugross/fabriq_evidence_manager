<Window x:Class="FabriqEvidenceManager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="設定"
        Height="600" Width="500"
        MinHeight="400" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        Background="#D2D6DB"
        ShowInTaskbar="False">

    <DockPanel Margin="16">

        <!-- 閉じるボタン (下端) -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="閉じる"
                    Click="OnCloseClick"
                    Padding="20,6"
                    MinWidth="100"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 注意書き -->
                <TextBlock Margin="0,0,0,16"
                           FontSize="11" Foreground="#555555"
                           TextWrapping="Wrap">
                    変更は即時反映されます。設定値はアプリ終了で破棄されます。
                </TextBlock>

                <!-- ===================================================== -->
                <!-- セクション 1: エビデンス取得チェック -->
                <!-- ===================================================== -->
                <TextBlock Text="◆ エビデンス取得チェック"
                           FontSize="13" FontWeight="Bold"
                           Foreground="#222222"
                           Margin="0,0,0,4"/>
                <TextBlock Text="OFF にした項目は欠損警告 (赤行) の対象から外れます。"
                           FontSize="10" Foreground="#777777"
                           Margin="0,0,0,8"/>

                <Border BorderBrush="#A4A8AD" BorderThickness="1" Padding="12" Margin="0,0,0,16" Background="#E1E4E7">
                    <StackPanel>
                        <CheckBox Content="MACアドレス (有線)"
                                  IsChecked="{Binding CheckOptions.CheckEthernetMac}"
                                  Margin="0,2"/>
                        <CheckBox Content="MACアドレス (Wi-Fi)"
                                  IsChecked="{Binding CheckOptions.CheckWifiMac}"
                                  Margin="0,2"/>
                        <CheckBox Content="BitLocker 回復キー"
                                  IsChecked="{Binding CheckOptions.CheckBitLocker}"
                                  Margin="0,2"/>
                        <CheckBox Content="pc_information ディレクトリ"
                                  IsChecked="{Binding CheckOptions.CheckPcInformation}"
                                  Margin="0,2"/>
                        <CheckBox Content="auto_capture ディレクトリ"
                                  IsChecked="{Binding CheckOptions.CheckAutoCapture}"
                                  Margin="0,2"/>
                        <CheckBox Content="チェックリストファイル"
                                  IsChecked="{Binding CheckOptions.CheckChecklist}"
                                  Margin="0,2"/>

                        <Border BorderBrush="#A4A8AD" BorderThickness="0,1,0,0" Margin="0,8,0,4"/>

                        <TextBlock Text="hostlist 突合の調整"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="#777777"
                                   Margin="0,4,0,2"/>
                        <CheckBox Content="余剰プリンタ検出 (hostlist にないプリンタを NG 扱い)"
                                  IsChecked="{Binding CheckOptions.CheckExtraPrinters}"
                                  Margin="0,2"/>
                    </StackPanel>
                </Border>

                <!-- ===================================================== -->
                <!-- セクション 2: ベースライン突合カテゴリ -->
                <!-- ===================================================== -->
                <TextBlock Text="◆ ベースライン突合カテゴリ"
                           FontSize="13" FontWeight="Bold"
                           Foreground="#222222"
                           Margin="0,0,0,4"/>
                <TextBlock Text="OFF にしたカテゴリは突合判定でスキップされ、差分件数の集計からも外れます。"
                           FontSize="10" Foreground="#777777"
                           Margin="0,0,0,4"/>
                <TextBlock Text="※ ベースラインが未設定でもチェックは保存されます。次回ベースライン設定時に有効になります。"
                           FontSize="10" Foreground="#999999"
                           Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBaselineLoaded}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border BorderBrush="#A4A8AD" BorderThickness="1" Padding="12" Background="#E1E4E7">
                    <ItemsControl ItemsSource="{Binding BaselineCategories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayName}"
                                          IsChecked="{Binding IsEnabled}"
                                          Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
