<Window x:Class="FabriqEvidenceManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Fabriq Evidence Manager"
        Height="700" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#BABEc2">


    <!-- ================================================================ -->
    <!-- メインレイアウト -->
    <!-- ================================================================ -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: ヘッダーバー (ロゴ + 青黄赤ストライプ) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Evidence フォルダ選択 -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: DataGrid (メインコンテンツ) -->
            <RowDefinition Height="*"/>
            <!-- Row 3: アクションボタン -->
            <RowDefinition Height="Auto"/>
            <!-- Row 4: ステータスバー -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================================================================ -->
        <!-- Row 0: ヘッダーバー — ロゴ + CentreCOM 青黄赤ストライプ -->
        <!-- ================================================================ -->
        <StackPanel Grid.Row="0" Background="#4A4A4A">
            <!-- ロゴ / 製品名 -->
            <Grid Margin="16,10,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FABRIQ"
                               FontSize="22" FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  EVIDENCE MANAGER"
                               FontSize="22" FontWeight="Light"
                               Foreground="#CCCCCC"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- (右端スペーサー) -->
            </Grid>

            <!-- Allied Telesis 風 3色ストライプ (青・黄・赤、上から下へ横線3本) -->
            <StackPanel Orientation="Vertical">
                <Rectangle Height="2" Fill="#4A90D9" HorizontalAlignment="Stretch"/>
                <Rectangle Height="2" Fill="#F2C94C" HorizontalAlignment="Stretch"/>
                <Rectangle Height="2" Fill="#EB5757" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </StackPanel>

        <!-- ================================================================ -->
        <!-- Row 1: Evidence フォルダ選択 -->
        <!-- ================================================================ -->
        <GroupBox Grid.Row="1" Header="Evidence フォルダ" Margin="12,8,12,4">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding EvidenceRootPath, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             IsReadOnly="True"/>

                    <Button Grid.Column="1"
                            Content="参照..."
                            Command="{Binding SelectEvidenceFolderCommand}"
                            Margin="6,0,0,0"/>

                    <Button Grid.Column="2"
                            Content="読み込み"
                            Command="{Binding LoadEvidenceCommand}"
                            Margin="6,0,0,0"
                            FontWeight="SemiBold"/>

                    <!-- 自動更新トグル -->
                    <CheckBox Grid.Column="3"
                              Content="自動更新 (30秒)"
                              IsChecked="{Binding IsAutoReloadEnabled}"
                              VerticalAlignment="Center"
                              Foreground="#2C2C2C"
                              FontSize="11"
                              Margin="10,0,0,0"/>
                </Grid>
            <!-- hostlist 読み込み -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Hostlist:"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="#2C2C2C"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBox Grid.Column="1"
                         Text="{Binding HostlistPath, Mode=OneWay}"
                         VerticalContentAlignment="Center"
                         IsReadOnly="True"
                         FontSize="11"/>

                <Button Grid.Column="2"
                        Content="CSV 読込..."
                        Command="{Binding LoadHostlistCommand}"
                        Margin="6,0,0,0"
                        FontSize="12"/>

                <TextBlock Grid.Column="3"
                           Text="{Binding HostlistStatusText}"
                           FontSize="11"
                           Foreground="#555555"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </Grid>
            <!-- ベースラインPC設定 -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Baseline PC:"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="#2C2C2C"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding BaselineStatusText}"
                           FontSize="11"
                           Foreground="#555555"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        Content="選択PCをベースラインに設定"
                        Command="{Binding SetBaselinePcCommand}"
                        Margin="6,0,0,0"
                        FontSize="12"/>

                <Button Grid.Column="3"
                        Content="クリア"
                        Command="{Binding ClearBaselineCommand}"
                        Margin="6,0,0,0"
                        FontSize="12"/>
            </Grid>
            </StackPanel>
        </GroupBox>

        <!-- ================================================================ -->
        <!-- Row 2: 検索バー + DataGrid — PC情報一覧 -->
        <!-- ================================================================ -->
        <DockPanel Grid.Row="2" Margin="12,4,12,4">

            <!-- 設定ボタン (取得チェック・ベースライン突合カテゴリは SettingsWindow に集約) -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                <Button Content="⚙ 設定"
                        Click="OnSettingsClick"
                        Padding="14,4"
                        FontSize="12"/>
            </StackPanel>

            <!-- 検索ボックス (上部に固定) -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="FILTER:"
                           FontSize="11" FontWeight="Bold"
                           Foreground="#555555"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding DisplayCountText}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#555555"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </Grid>

            <!-- DataGrid (詳細はダブルクリックで別窓表示。PcDetailWindow.xaml) -->
            <Grid>
                <DataGrid ItemsSource="{Binding TargetPCsView}"
                      SelectedItem="{Binding SelectedPc}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      ClipboardCopyMode="IncludeHeader"
                      HeadersVisibility="Column"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">

                    <!-- 行ハイライト: HasCaution=黄, HasWarning=赤 (赤が優先)
                         + MouseDoubleClick で PcDetailWindow を別窓表示 -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <EventSetter Event="MouseDoubleClick" Handler="OnPcRowDoubleClick"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCaution}" Value="True">
                                    <Setter Property="Background" Value="#FFF9C4"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                    <Setter Property="Background" Value="#FFCDD2"/>
                                </DataTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="#D2D4D9"/>
                                </MultiTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <!-- 計画 PC 名 (hostlist で選択された名前 = manifest.selectedNewPcName)
                             + メモ有り PC には末尾に 📝 アイコン (HasMemo=true 時) -->
                        <DataGridTemplateColumn Header="計画 PC 名"
                                                MinWidth="100"
                                                Width="SizeToCells">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding PcName}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#222222"
                                                   Padding="4,2"/>
                                        <TextBlock Text=" 📝"
                                                   FontSize="11"
                                                   Foreground="#1565C0"
                                                   ToolTip="管理者メモあり"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding HasMemo, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 実 PC 名 (manifest.computerName = $env:COMPUTERNAME / rename 後の現在の名前) -->
                        <DataGridTextColumn Header="実 PC 名"
                                            Binding="{Binding ActualComputerNameDisplay}"
                                            MinWidth="100"
                                            Width="SizeToCells">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#222222"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPcNameMismatch}" Value="True">
                                            <Setter Property="Foreground" Value="#C62828"/>
                                            <Setter Property="Background" Value="#FCE4EC"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- シリアルナンバー (採用ソース併記。フォールバック取得時は黄色強調) -->
                        <DataGridTextColumn Header="シリアル"
                                            Binding="{Binding SerialNumberDisplay}"
                                            MinWidth="160"
                                            Width="SizeToCells">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSerialFallbackWarning}" Value="True">
                                            <Setter Property="Foreground" Value="#E65100"/>
                                            <Setter Property="Background" Value="#FFF3E0"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 収集日 -->
                        <DataGridTextColumn Header="収集日"
                                            Binding="{Binding CollectionDate}"
                                            MinWidth="90"
                                            Width="SizeToCells"/>

                        <!-- イーサネットMAC -->
                        <DataGridTextColumn Header="MAC (イーサネット)"
                                            Binding="{Binding EthernetMac}"
                                            MinWidth="140"
                                            Width="SizeToCells"/>

                        <!-- Wi-Fi MAC -->
                        <DataGridTextColumn Header="MAC (Wi-Fi)"
                                            Binding="{Binding WifiMac}"
                                            MinWidth="140"
                                            Width="SizeToCells"/>

                        <!-- BitLocker (ドライブレター + 回復キー併記、ItemsControl で行毎レイアウト) -->
                        <DataGridTemplateColumn Header="BitLocker (回復キー)"
                                                MinWidth="280"
                                                Width="SizeToCells">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding BitLockerKeys}" Margin="4,2">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontFamily="Consolas" FontSize="11">
                                                    <Run Text="{Binding DriveLetter, Mode=OneWay}" FontWeight="Bold"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding RecoveryPassword, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Windows ライセンス認証 (M11: 監査用) -->
                        <DataGridTextColumn Header="Win 認証"
                                            Binding="{Binding WindowsLicenseStatusDisplay}"
                                            MinWidth="80"
                                            Width="SizeToCells">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="6,2"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Background"
                                            Value="{Binding WindowsLicenseStatusDisplay,
                                                            Converter={StaticResource LicenseStatusToBg}}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Office ライセンス認証 (M11: 監査用) -->
                        <DataGridTextColumn Header="Office 認証"
                                            Binding="{Binding OfficeLicenseStatusDisplay}"
                                            MinWidth="110"
                                            Width="SizeToCells">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="6,2"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Background"
                                            Value="{Binding OfficeLicenseStatusDisplay,
                                                            Converter={StaticResource LicenseStatusToBg}}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 検出状況 -->
                        <DataGridTextColumn Header="検出エビデンス"
                                            Binding="{Binding DetectedItems}"
                                            MinWidth="120"
                                            Width="SizeToCells"/>

                        <!-- ステータス (警告 + 要確認メッセージ) -->
                        <DataGridTemplateColumn Header="ステータス" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" Margin="4,2">
                                        <TextBlock Text="{Binding WarningMessage}"
                                                   Foreground="#C62828"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding CautionMessage}"
                                                   Foreground="#E65100"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasCaution, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

            </Grid>

        </DockPanel>

        <!-- ================================================================ -->
        <!-- Row 3: アクションボタン -->
        <!-- ================================================================ -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="12,4,12,4">

            <Button Content="納品データ出力"
                    Command="{Binding ExportDeliveryCommand}"
                    Padding="20,8"
                    FontWeight="SemiBold"
                    FontSize="14"/>
        </StackPanel>

        <!-- ================================================================ -->
        <!-- Row 4: ステータスバー (LED + ProgressBar + Message) -->
        <!-- ================================================================ -->
        <Border Grid.Row="4"
                Background="#4A4A4A"
                BorderBrush="#757B82"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- プログレスバー (読み込み中のみ表示) -->
                <ProgressBar Grid.Row="0"
                             IsIndeterminate="True"
                             Height="3"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                             Margin="0,0,0,6"/>

                <!-- LED + ステータスメッセージ -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LINK/ACT LED インジケータ -->
                    <Ellipse x:Name="LinkActLed"
                             Grid.Column="0"
                             Width="8" Height="8"
                             Fill="#00FF00"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#00FF00"
                                              BlurRadius="8"
                                              ShadowDepth="0"
                                              Opacity="0.7"/>
                        </Ellipse.Effect>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="LedBlink">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="1.0" To="0.15"
                                                        Duration="0:0:0.5"
                                                        AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="LedBlink"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Grid.Column="1"
                               Text="LINK/ACT"
                               FontSize="9"
                               Foreground="#AAAAAA"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>

                    <!-- ステータスメッセージ -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="#CCCCCC"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>
