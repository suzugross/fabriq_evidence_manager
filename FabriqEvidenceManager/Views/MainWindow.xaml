<Window x:Class="FabriqEvidenceManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Fabriq Evidence Manager"
        Height="700" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#BABEc2">

    <Window.Resources>
        <!-- Bool → Visibility 変換 -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ============================================================ -->
        <!-- CentreCOM テーマ: Button (明るい筐体に馴染むパーツ風) -->
        <!-- ============================================================ -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#989DA1"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#757B82"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#AAAEB3"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4CAF50"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#84898E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#388E3C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#B2B6BA"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94989C"/>
                                <Setter Property="Foreground" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ -->
        <!-- CentreCOM テーマ: TextBox -->
        <!-- ============================================================ -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#757B82"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="Black"/>
            <Setter Property="SelectionBrush" Value="#4CAF50"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <!-- ============================================================ -->
        <!-- CentreCOM テーマ: TextBlock (デフォルト) -->
        <!-- ============================================================ -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2C2C2C"/>
        </Style>

        <!-- ============================================================ -->
        <!-- CentreCOM テーマ: GroupBox -->
        <!-- ============================================================ -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#2C2C2C"/>
            <Setter Property="BorderBrush" Value="#757B82"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- ============================================================ -->
        <!-- CentreCOM テーマ: DataGrid -->
        <!-- ============================================================ -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#E1E4E7"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#757B82"/>
            <Setter Property="RowBackground" Value="#EDEEEF"/>
            <Setter Property="AlternatingRowBackground" Value="#E1E4E7"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#A4A8AD"/>
            <Setter Property="VerticalGridLinesBrush" Value="#A4A8AD"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        </Style>

        <!-- DataGrid ColumnHeader -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#A0A6AB"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#757B82"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- DataGrid Cell -->
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#A4A8AD"/>
            <Setter Property="BorderThickness" Value="0,0,0,0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4CAF50"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#388E3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================ -->
        <!-- CentreCOM テーマ: ProgressBar (ネットワーク風グリーン) -->
        <!-- ============================================================ -->
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#A4A8AD"/>
            <Setter Property="Foreground" Value="#4CAF50"/>
            <Setter Property="BorderBrush" Value="#757B82"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </Window.Resources>

    <!-- ================================================================ -->
    <!-- メインレイアウト -->
    <!-- ================================================================ -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: ヘッダーバー (ロゴ + 青黄赤ストライプ) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Evidence フォルダ選択 -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: DataGrid (メインコンテンツ) -->
            <RowDefinition Height="*"/>
            <!-- Row 3: アクションボタン -->
            <RowDefinition Height="Auto"/>
            <!-- Row 4: ステータスバー -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================================================================ -->
        <!-- Row 0: ヘッダーバー — ロゴ + CentreCOM 青黄赤ストライプ -->
        <!-- ================================================================ -->
        <StackPanel Grid.Row="0" Background="#4A4A4A">
            <!-- ロゴ / 製品名 -->
            <Grid Margin="16,10,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FABRIQ"
                               FontSize="22" FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  EVIDENCE MANAGER"
                               FontSize="22" FontWeight="Light"
                               Foreground="#CCCCCC"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- (右端スペーサー) -->
            </Grid>

            <!-- Allied Telesis 風 3色ストライプ (青・黄・赤、上から下へ横線3本) -->
            <StackPanel Orientation="Vertical">
                <Rectangle Height="2" Fill="#4A90D9" HorizontalAlignment="Stretch"/>
                <Rectangle Height="2" Fill="#F2C94C" HorizontalAlignment="Stretch"/>
                <Rectangle Height="2" Fill="#EB5757" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </StackPanel>

        <!-- ================================================================ -->
        <!-- Row 1: Evidence フォルダ選択 -->
        <!-- ================================================================ -->
        <GroupBox Grid.Row="1" Header="Evidence フォルダ" Margin="12,8,12,4">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- モード切替 -->
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding AvailableModes}"
                              SelectedItem="{Binding SelectedMode}"
                              VerticalContentAlignment="Center"
                              Margin="0,0,6,0"
                              MinWidth="90"
                              FontSize="12"/>

                    <TextBox Grid.Column="1"
                             Text="{Binding EvidenceRootPath, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             IsReadOnly="True"/>

                    <Button Grid.Column="2"
                            Content="参照..."
                            Command="{Binding SelectEvidenceFolderCommand}"
                            Margin="6,0,0,0"/>

                    <Button Grid.Column="3"
                            Content="読み込み"
                            Command="{Binding LoadEvidenceCommand}"
                            Margin="6,0,0,0"
                            FontWeight="SemiBold"/>

                    <!-- 自動更新トグル -->
                    <CheckBox Grid.Column="4"
                              Content="自動更新 (30秒)"
                              IsChecked="{Binding IsAutoReloadEnabled}"
                              VerticalAlignment="Center"
                              Foreground="#2C2C2C"
                              FontSize="11"
                              Margin="10,0,0,0"/>
                </Grid>
            <!-- hostlist 読み込み -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Hostlist:"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="#2C2C2C"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBox Grid.Column="1"
                         Text="{Binding HostlistPath, Mode=OneWay}"
                         VerticalContentAlignment="Center"
                         IsReadOnly="True"
                         FontSize="11"/>

                <Button Grid.Column="2"
                        Content="CSV 読込..."
                        Command="{Binding LoadHostlistCommand}"
                        Margin="6,0,0,0"
                        FontSize="12"/>

                <TextBlock Grid.Column="3"
                           Text="{Binding HostlistStatusText}"
                           FontSize="11"
                           Foreground="#555555"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </Grid>
            <!-- ベースライン読み込み -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Baseline:"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="#2C2C2C"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBox Grid.Column="1"
                         Text="{Binding BaselinePath, Mode=OneWay}"
                         VerticalContentAlignment="Center"
                         IsReadOnly="True"
                         FontSize="11"/>

                <Button Grid.Column="2"
                        Content="CSV 読込..."
                        Command="{Binding LoadBaselineCommand}"
                        Margin="6,0,0,0"
                        FontSize="12"/>

                <TextBlock Grid.Column="3"
                           Text="{Binding BaselineStatusText}"
                           FontSize="11"
                           Foreground="#555555"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </Grid>
            </StackPanel>
        </GroupBox>

        <!-- ================================================================ -->
        <!-- Row 2: 検索バー + DataGrid — PC情報一覧 -->
        <!-- ================================================================ -->
        <DockPanel Grid.Row="2" Margin="12,4,12,4">

            <!-- エビデンス取得チェック項目 -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="取得チェック:"
                           FontSize="11" FontWeight="Bold"
                           Foreground="#555555"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <CheckBox Content="MAC(有線)"
                          IsChecked="{Binding CheckOptions.CheckEthernetMac}"
                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                <CheckBox Content="MAC(Wi-Fi)"
                          IsChecked="{Binding CheckOptions.CheckWifiMac}"
                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                <CheckBox Content="BitLocker"
                          IsChecked="{Binding CheckOptions.CheckBitLocker}"
                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                <CheckBox Content="PC情報"
                          IsChecked="{Binding CheckOptions.CheckPcInformation}"
                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                <CheckBox Content="キャプチャ"
                          IsChecked="{Binding CheckOptions.CheckAutoCapture}"
                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                <CheckBox Content="チェックリスト"
                          IsChecked="{Binding CheckOptions.CheckChecklist}"
                          VerticalAlignment="Center" Margin="0,0,12,0"/>
            </StackPanel>

            <!-- 検索ボックス (上部に固定) -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="FILTER:"
                           FontSize="11" FontWeight="Bold"
                           Foreground="#555555"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding DisplayCountText}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#555555"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </Grid>

            <!-- DataGrid + GridSplitter + Preview Panel -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="400" MinWidth="250"/>
                </Grid.ColumnDefinitions>

                <!-- DataGrid (左) -->
                <DataGrid Grid.Column="0"
                      ItemsSource="{Binding TargetPCsView}"
                      SelectedItem="{Binding SelectedPc}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      ClipboardCopyMode="IncludeHeader"
                      HeadersVisibility="Column"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">

                    <!-- 行ハイライト: HasCaution=黄, HasWarning=赤 (赤が優先) -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCaution}" Value="True">
                                    <Setter Property="Background" Value="#FFF9C4"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                    <Setter Property="Background" Value="#FFCDD2"/>
                                </DataTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="#D2D4D9"/>
                                </MultiTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <!-- PC名 -->
                        <DataGridTextColumn Header="PC名"
                                            Binding="{Binding PcName}"
                                            MinWidth="100"
                                            Width="SizeToCells">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#222222"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- シリアルナンバー -->
                        <DataGridTextColumn Header="シリアル"
                                            Binding="{Binding SerialNumber}"
                                            MinWidth="120"
                                            Width="SizeToCells"/>

                        <!-- 収集日 -->
                        <DataGridTextColumn Header="収集日"
                                            Binding="{Binding CollectionDate}"
                                            MinWidth="90"
                                            Width="SizeToCells"/>

                        <!-- イーサネットMAC -->
                        <DataGridTextColumn Header="MAC (イーサネット)"
                                            Binding="{Binding EthernetMac}"
                                            MinWidth="140"
                                            Width="SizeToCells"/>

                        <!-- Wi-Fi MAC -->
                        <DataGridTextColumn Header="MAC (Wi-Fi)"
                                            Binding="{Binding WifiMac}"
                                            MinWidth="140"
                                            Width="SizeToCells"/>

                        <!-- BitLocker ドライブ -->
                        <DataGridTextColumn Header="BitLocker"
                                            Binding="{Binding BitLockerDrives}"
                                            MinWidth="70"
                                            Width="SizeToCells"/>

                        <!-- 検出状況 -->
                        <DataGridTextColumn Header="検出エビデンス"
                                            Binding="{Binding DetectedItems}"
                                            MinWidth="120"
                                            Width="SizeToCells"/>

                        <!-- ステータス (警告 + 要確認メッセージ) -->
                        <DataGridTemplateColumn Header="ステータス" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" Margin="4,2">
                                        <TextBlock Text="{Binding WarningMessage}"
                                                   Foreground="#C62828"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding CautionMessage}"
                                                   Foreground="#E65100"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasCaution, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- GridSplitter (ドラッグでプレビュー幅を調整) -->
                <GridSplitter Grid.Column="1"
                              Width="5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              Background="#A0A6AB"
                              Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}"/>

                <!-- プレビューパネル (右, SelectedPc != null 時のみ表示) -->
                <Border Grid.Column="2"
                        BorderBrush="#757B82"
                        BorderThickness="1,0,0,0"
                        Background="#D2D6DB"
                        Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8">
                        <StackPanel>

                            <!-- PC名ヘッダー -->
                            <TextBlock Text="{Binding SelectedPc.PcName}"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="#222222"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding SelectedPc.SerialNumber}"
                                       FontSize="12"
                                       Foreground="#666666"
                                       Margin="0,0,0,10"/>

                            <!-- セクション: キャプチャプレビュー -->
                            <TextBlock Text="AUTO CAPTURE"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#757B82"
                                       Margin="0,0,0,4"/>
                            <Border BorderBrush="#757B82" BorderThickness="1"
                                    Background="#2C2C2C" MinHeight="180"
                                    Margin="0,0,0,4">
                                <Grid>
                                    <!-- 画像あり -->
                                    <Image Source="{Binding CurrentPreviewImagePath}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <!-- 画像なし時のプレースホルダ -->
                                    <TextBlock Text="No Image"
                                               FontSize="14"
                                               Foreground="#777777"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentPreviewImagePath}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- ナビゲーション (前へ / カウンター / 次へ) -->
                            <Grid Margin="0,0,0,12"
                                  Visibility="{Binding HasMultipleImages, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="&lt; 前へ"
                                        Command="{Binding PreviousPreviewImageCommand}"
                                        Padding="10,3" FontSize="11"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding PreviewCounterText}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#555555"/>

                                <Button Grid.Column="2"
                                        Content="次へ &gt;"
                                        Command="{Binding NextPreviewImageCommand}"
                                        Padding="10,3" FontSize="11"/>
                            </Grid>

                            <!-- セクション: エビデンス詳細 -->
                            <TextBlock Text="EVIDENCE DETAILS"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#757B82"
                                       Margin="0,0,0,6"/>

                            <!-- MAC (有線) -->
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="有線 MAC:" FontSize="11" Foreground="#666666"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedPc.EthernetMac}" FontSize="11" FontFamily="Consolas"/>
                            </Grid>

                            <!-- MAC (Wi-Fi) -->
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Wi-Fi MAC:" FontSize="11" Foreground="#666666"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedPc.WifiMac}" FontSize="11" FontFamily="Consolas"/>
                            </Grid>

                            <!-- BitLocker -->
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="BitLocker:" FontSize="11" Foreground="#666666"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedPc.BitLockerDrives}" FontSize="11"/>
                            </Grid>

                            <!-- チェックリスト -->
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Checklist:" FontSize="11" Foreground="#666666"/>
                                <TextBlock Grid.Column="1" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding ChecklistFileName}"/>
                                            <Setter Property="Foreground" Value="#2C2C2C"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ChecklistFileName}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="未検出"/>
                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- 警告メッセージ (赤: エビデンス欠損) -->
                            <Border Margin="0,10,0,0" Padding="8,6"
                                    Background="#FFEBEE" BorderBrush="#C62828" BorderThickness="1"
                                    Visibility="{Binding SelectedPc.HasWarning, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SelectedPc.WarningMessage}"
                                           FontSize="11" Foreground="#C62828"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <!-- 要確認メッセージ (黄: hostlist不一致/ベースラインNG/チェックリストNG) -->
                            <Border Margin="0,6,0,0" Padding="8,6"
                                    Background="#FFF8E1" BorderBrush="#E65100" BorderThickness="1"
                                    Visibility="{Binding SelectedPc.HasCaution, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SelectedPc.CautionMessage}"
                                           FontSize="11" Foreground="#E65100"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <!-- ============================================ -->
                            <!-- セクション: HOSTLIST 突合結果 -->
                            <!-- ============================================ -->
                            <TextBlock Text="HOSTLIST VERIFICATION"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#757B82"
                                       Margin="0,14,0,4"
                                       Visibility="{Binding IsHostlistLoaded, Converter={StaticResource BoolToVis}}"/>

                            <!-- 突合テーブル (hostlist 読込済み かつ レポートあり) -->
                            <ItemsControl ItemsSource="{Binding CurrentVerificationReport.Items}"
                                          Margin="0,0,0,6"
                                          Visibility="{Binding IsHostlistLoaded, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ItemName}"
                                                       FontSize="10" Foreground="#555555"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ItemName}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Expected}"
                                                       FontSize="10" Foreground="#666666" FontFamily="Consolas"
                                                       TextTrimming="CharacterEllipsis" Margin="4,0"
                                                       ToolTip="{Binding Expected}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Actual}"
                                                       FontSize="10" FontFamily="Consolas"
                                                       TextTrimming="CharacterEllipsis" Margin="4,0"
                                                       ToolTip="{Binding Actual}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#222222"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Mismatch">
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="NoActual">
                                                                <Setter Property="Foreground" Value="#E65100"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="3" FontSize="9" FontWeight="Bold" Margin="4,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="OK"/>
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Mismatch">
                                                                <Setter Property="Text" Value="NG"/>
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="NoActual">
                                                                <Setter Property="Text" Value="--"/>
                                                                <Setter Property="Foreground" Value="#E65100"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="NoExpected">
                                                                <Setter Property="Text" Value="--"/>
                                                                <Setter Property="Foreground" Value="#999999"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ============================================ -->
                            <!-- セクション: チェックリスト結果 -->
                            <!-- ============================================ -->
                            <TextBlock Text="CHECKLIST"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#757B82"
                                       Margin="0,8,0,4"/>

                            <!-- チェックリスト Overall ステータス -->
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Overall:" FontSize="11" Foreground="#666666"/>
                                <TextBlock Grid.Column="1" FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding CurrentChecklistResult.OverallStatus}"/>
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentChecklistResult}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="未検出"/>
                                                    <Setter Property="Foreground" Value="#999999"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentChecklistResult.OverallStatus}" Value="NG">
                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- モジュール実行サマリ -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock FontSize="10" Foreground="#2E7D32" Margin="0,0,8,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="OK: {0}">
                                            <Binding Path="CurrentChecklistResult.OkCount" FallbackValue="0"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock FontSize="10" Foreground="#C62828" Margin="0,0,8,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="NG: {0}">
                                            <Binding Path="CurrentChecklistResult.NgCount" FallbackValue="0"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock FontSize="10" Foreground="#666666">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="Skip: {0}">
                                            <Binding Path="CurrentChecklistResult.SkipCount" FallbackValue="0"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>

                            <!-- モジュール実行一覧 -->
                            <ItemsControl ItemsSource="{Binding CurrentChecklistResult.ModuleItems}"
                                          Margin="0,0,0,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontSize="9" FontWeight="Bold"
                                                       Margin="0,0,6,0" MinWidth="24">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Status}"/>
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="NG">
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Skip">
                                                                <Setter Property="Foreground" Value="#666666"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding ModuleName}"
                                                       FontSize="10" Foreground="#333333"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Message}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Time}"
                                                       FontSize="9" Foreground="#888888"
                                                       Margin="4,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ============================================ -->
                            <!-- セクション: 実行履歴 -->
                            <!-- ============================================ -->
                            <TextBlock Text="EXECUTION HISTORY"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#757B82"
                                       Margin="0,8,0,4"/>

                            <ItemsControl ItemsSource="{Binding CurrentExportHistory}"
                                          Margin="0,0,0,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontSize="9" FontWeight="Bold"
                                                       Margin="0,0,6,0" MinWidth="36">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Status}"/>
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                                                <Setter Property="Foreground" Value="#666666"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding ModuleName}"
                                                       FontSize="10" Foreground="#333333"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Message}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Timestamp}"
                                                       FontSize="9" Foreground="#888888"
                                                       Margin="4,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ============================================ -->
                            <!-- セクション: ベースライン突合 -->
                            <!-- ============================================ -->
                            <TextBlock Text="BASELINE COMPARISON"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#757B82"
                                       Margin="0,8,0,4"
                                       Visibility="{Binding IsBaselineLoaded, Converter={StaticResource BoolToVis}}"/>

                            <ItemsControl ItemsSource="{Binding CurrentBaselineReport.Items}"
                                          Margin="0,0,0,6"
                                          Visibility="{Binding IsBaselineLoaded, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 判定バッジ -->
                                            <TextBlock Grid.Column="0" FontSize="9" FontWeight="Bold"
                                                       Margin="0,0,6,0" MinWidth="28">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="OK"/>
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MatchStatus}" Value="Mismatch">
                                                                <Setter Property="Text" Value="NG"/>
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MatchStatus}" Value="MissingInActual">
                                                                <Setter Property="Text" Value="MISS"/>
                                                                <Setter Property="Foreground" Value="#E65100"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MatchStatus}" Value="ExtraInActual">
                                                                <Setter Property="Text" Value="EXTRA"/>
                                                                <Setter Property="Foreground" Value="#666666"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- モジュール名 -->
                                            <TextBlock Grid.Column="1" Text="{Binding ModuleName}"
                                                       FontSize="10" Foreground="#333333"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <!-- 期待ステータス -->
                                            <TextBlock Grid.Column="2" Text="{Binding ExpectedStatus}"
                                                       FontSize="9" Foreground="#888888"
                                                       Margin="4,0,0,0"/>

                                            <!-- 実測ステータス (不一致時は赤) -->
                                            <TextBlock Grid.Column="3" FontSize="9" Margin="4,0,0,0"
                                                       Text="{Binding ActualStatus}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#888888"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MatchStatus}" Value="Mismatch">
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MatchStatus}" Value="MissingInActual">
                                                                <Setter Property="Foreground" Value="#E65100"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

        </DockPanel>

        <!-- ================================================================ -->
        <!-- Row 3: アクションボタン -->
        <!-- ================================================================ -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="12,4,12,4">

            <Button Content="納品データ出力"
                    Command="{Binding ExportDeliveryCommand}"
                    Padding="20,8"
                    FontWeight="SemiBold"
                    FontSize="14"/>
        </StackPanel>

        <!-- ================================================================ -->
        <!-- Row 4: ステータスバー (LED + ProgressBar + Message) -->
        <!-- ================================================================ -->
        <Border Grid.Row="4"
                Background="#4A4A4A"
                BorderBrush="#757B82"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- プログレスバー (読み込み中のみ表示) -->
                <ProgressBar Grid.Row="0"
                             IsIndeterminate="True"
                             Height="3"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                             Margin="0,0,0,6"/>

                <!-- LED + ステータスメッセージ -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LINK/ACT LED インジケータ -->
                    <Ellipse x:Name="LinkActLed"
                             Grid.Column="0"
                             Width="8" Height="8"
                             Fill="#00FF00"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#00FF00"
                                              BlurRadius="8"
                                              ShadowDepth="0"
                                              Opacity="0.7"/>
                        </Ellipse.Effect>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="LedBlink">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="1.0" To="0.15"
                                                        Duration="0:0:0.5"
                                                        AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="LedBlink"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Grid.Column="1"
                               Text="LINK/ACT"
                               FontSize="9"
                               Foreground="#AAAAAA"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>

                    <!-- ステータスメッセージ -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="#CCCCCC"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>
