                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Antivirus" FontSize="10" Foreground="#888"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding SelectedPc.DefenderStatus.AntivirusEnabled}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="RealTime" FontSize="10" Foreground="#888"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SelectedPc.DefenderStatus.RealTimeProtectionEnabled}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Antispyware" FontSize="10" Foreground="#888"/>
                                <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding SelectedPc.DefenderStatus.AntispywareEnabled}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="0" Grid.Column="6" Text="NIS" FontSize="10" Foreground="#888"/>
                                <TextBlock Grid.Row="1" Grid.Column="6" Text="{Binding SelectedPc.DefenderStatus.NISEnabled}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="エンジン" FontSize="10" Foreground="#888"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding SelectedPc.DefenderStatus.AMEngineVersion}" FontSize="11"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="製品" FontSize="10" Foreground="#888"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding SelectedPc.DefenderStatus.AMProductVersion}" FontSize="11"/>
                                <TextBlock Grid.Row="3" Grid.Column="4" Text="定義" FontSize="10" Foreground="#888"/>
                                <TextBlock Grid.Row="4" Grid.Column="4" Text="{Binding SelectedPc.DefenderStatus.AntivirusSignatureVersion}" FontSize="11"/>
                                <TextBlock Grid.Row="3" Grid.Column="6" Text="定義更新日" FontSize="10" Foreground="#888"/>
                                <TextBlock Grid.Row="4" Grid.Column="6" Text="{Binding SelectedPc.DefenderStatus.AntivirusSignatureLastUpdated}" FontSize="11"/>
                            </Grid>

                            <!-- ============================================ -->
                            <!-- セクション: Windows Update -->
                            <!-- ============================================ -->
                            <TextBlock FontSize="10" FontWeight="Bold"
                                       Foreground="#757B82"
                                       Margin="0,12,0,6"
                                       Visibility="{Binding HasWindowsUpdates, Converter={StaticResource BoolToVis}}">
                                <Run Text="WINDOWS UPDATES"/>
                                <Run Text=" (" Foreground="#999999"/><Run Text="{Binding SelectedPc.WindowsUpdates.Count, Mode=OneWay}" Foreground="#999999"/><Run Text=")" Foreground="#999999"/>
                            </TextBlock>
                            <DataGrid ItemsSource="{Binding SelectedPc.WindowsUpdates}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      BorderThickness="1" BorderBrush="#E0E0E0"
                                      RowHeight="24" FontSize="11"
                                      MaxHeight="200"
                                      Visibility="{Binding HasWindowsUpdates, Converter={StaticResource BoolToVis}}"
                                      Margin="0,0,0,4">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="KB" Binding="{Binding HotFixID}" Width="100"/>
                                    <DataGridTextColumn Header="種別" Binding="{Binding Description}" Width="80"/>
                                    <DataGridTextColumn Header="インストール者" Binding="{Binding InstalledBy}" Width="180"/>
                                    <DataGridTextColumn Header="日時" Binding="{Binding InstalledOn}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- ============================================ -->
                            <!-- セクション: HOSTLIST 突合結果 -->
                            <!-- ============================================ -->
                            <TextBlock Text="HOSTLIST VERIFICATION"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#757B82"
                                       Margin="0,14,0,4"
                                       Visibility="{Binding IsHostlistLoaded, Converter={StaticResource BoolToVis}}"/>

                            <!-- 突合テーブル (hostlist 読込済み かつ レポートあり) -->
                            <ItemsControl ItemsSource="{Binding CurrentVerificationReport.Items}"
                                          Margin="0,0,0,6"
                                          Visibility="{Binding IsHostlistLoaded, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ItemName}"
                                                       FontSize="10" Foreground="#555555"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ItemName}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Expected}"
                                                       FontSize="10" Foreground="#666666" FontFamily="Consolas"
                                                       TextTrimming="CharacterEllipsis" Margin="4,0"
                                                       ToolTip="{Binding Expected}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Actual}"
                                                       FontSize="10" FontFamily="Consolas"
                                                       TextTrimming="CharacterEllipsis" Margin="4,0"
                                                       ToolTip="{Binding Actual}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#222222"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Mismatch">
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="NoActual">
                                                                <Setter Property="Foreground" Value="#E65100"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="3" FontSize="9" FontWeight="Bold" Margin="4,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="OK"/>
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Mismatch">
                                                                <Setter Property="Text" Value="NG"/>
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="NoActual">
                                                                <Setter Property="Text" Value="NG"/>
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="NoExpected">
                                                                <Setter Property="Text" Value="--"/>
                                                                <Setter Property="Foreground" Value="#999999"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ============================================ -->
                            <!-- セクション: チェックリスト結果 -->
                            <!-- ============================================ -->
                            <TextBlock Text="CHECKLIST"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#757B82"
                                       Margin="0,8,0,4"/>

                            <!-- チェックリスト Overall ステータス -->
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Overall:" FontSize="11" Foreground="#666666"/>
                                <TextBlock Grid.Column="1" FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding CurrentChecklistResult.OverallStatus}"/>
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentChecklistResult}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="未検出"/>
                                                    <Setter Property="Foreground" Value="#999999"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentChecklistResult.OverallStatus}" Value="NG">
                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- モジュール実行サマリ -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock FontSize="10" Foreground="#2E7D32" Margin="0,0,8,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="OK: {0}">
                                            <Binding Path="CurrentChecklistResult.OkCount" FallbackValue="0"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock FontSize="10" Foreground="#C62828" Margin="0,0,8,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="NG: {0}">
                                            <Binding Path="CurrentChecklistResult.NgCount" FallbackValue="0"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock FontSize="10" Foreground="#666666">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="Skip: {0}">
                                            <Binding Path="CurrentChecklistResult.SkipCount" FallbackValue="0"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>

                            <!-- モジュール実行一覧 -->
                            <ItemsControl ItemsSource="{Binding CurrentChecklistResult.ModuleItems}"
                                          Margin="0,0,0,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontSize="9" FontWeight="Bold"
                                                       Margin="0,0,6,0" MinWidth="24">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Status}"/>
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="NG">
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Skip">
                                                                <Setter Property="Foreground" Value="#666666"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding ModuleName}"
                                                       FontSize="10" Foreground="#333333"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Message}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Time}"
                                                       FontSize="9" Foreground="#888888"
                                                       Margin="4,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ============================================ -->
                            <!-- セクション: 実行履歴 -->
                            <!-- ============================================ -->
                            <TextBlock Text="EXECUTION HISTORY"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#757B82"
                                       Margin="0,8,0,4"/>

                            <ItemsControl ItemsSource="{Binding CurrentExportHistory}"
                                          Margin="0,0,0,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontSize="9" FontWeight="Bold"
                                                       Margin="0,0,6,0" MinWidth="36">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Status}"/>
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                                                <Setter Property="Foreground" Value="#666666"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding ModuleName}"
                                                       FontSize="10" Foreground="#333333"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Message}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Timestamp}"
                                                       FontSize="9" Foreground="#888888"
                                                       Margin="4,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ============================================ -->
                            <!-- セクション: ベースライン突合 — Windowsバージョン情報 -->
                            <!-- ============================================ -->
                            <TextBlock Text="BASELINE — SYSTEM INFO"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#757B82"
                                       Margin="0,8,0,4"
                                       Visibility="{Binding IsBaselineLoaded, Converter={StaticResource BoolToVis}}"/>

                            <ItemsControl ItemsSource="{Binding CurrentBaselineReport.SystemInfoComparison.Items}"
                                          Margin="0,0,0,6"
                                          Visibility="{Binding IsBaselineLoaded, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 判定バッジ -->
                                            <TextBlock Grid.Column="0" FontSize="9" FontWeight="Bold"
                                                       Margin="0,0,6,0" MinWidth="28">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="OK"/>
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Mismatch">
                                                                <Setter Property="Text" Value="NG"/>
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="NoActual">
                                                                <Setter Property="Text" Value="---"/>
                                                                <Setter Property="Foreground" Value="#E65100"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="NoExpected">
                                                                <Setter Property="Text" Value="---"/>
                                                                <Setter Property="Foreground" Value="#888888"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- 項目名 -->
                                            <TextBlock Grid.Column="1" Text="{Binding ItemName}"
                                                       FontSize="10" Foreground="#333333"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <!-- 期待値 (ベースライン) -->
                                            <TextBlock Grid.Column="2" Text="{Binding Expected}"
                                                       FontSize="9" Foreground="#888888"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="4,0,0,0"/>

                                            <!-- 実測値 (不一致時は赤) -->
                                            <TextBlock Grid.Column="3" FontSize="9" Margin="4,0,0,0"
                                                       Text="{Binding Actual}"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#888888"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Mismatch">
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ============================================ -->
                            <!-- セクション: ベースライン突合 — チェックリスト -->
                            <!-- ============================================ -->
                            <TextBlock Text="BASELINE — CHECKLIST"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#757B82"
                                       Margin="0,8,0,4"
                                       Visibility="{Binding IsBaselineLoaded, Converter={StaticResource BoolToVis}}"/>

                            <!-- OverallStatus 照合 -->
                            <Grid Margin="0,0,0,2"
                                  Visibility="{Binding IsBaselineLoaded, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" FontSize="9" FontWeight="Bold"
                                           Margin="0,0,6,0" MinWidth="28">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="OK"/>
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentBaselineReport.ChecklistComparison.OverallStatusMatch}" Value="False">
                                                    <Setter Property="Text" Value="NG"/>
                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Column="1" Text="全体判定"
                                           FontSize="10" Foreground="#333333"/>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding CurrentBaselineReport.ChecklistComparison.BaselineOverallStatus}"
                                           FontSize="9" Foreground="#888888"
                                           Margin="4,0,0,0"/>

                                <TextBlock Grid.Column="3" FontSize="9" Margin="4,0,0,0"
                                           Text="{Binding CurrentBaselineReport.ChecklistComparison.ActualOverallStatus}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#888888"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentBaselineReport.ChecklistComparison.OverallStatusMatch}" Value="False">
                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- VerifyItems 照合 -->
                            <ItemsControl ItemsSource="{Binding CurrentBaselineReport.ChecklistComparison.VerifyItemComparisons}"
                                          Margin="0,0,0,6"
                                          Visibility="{Binding IsBaselineLoaded, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 判定バッジ -->
                                            <TextBlock Grid.Column="0" FontSize="9" FontWeight="Bold"
                                                       Margin="0,0,6,0" MinWidth="28">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="OK"/>
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Mismatch">
                                                                <Setter Property="Text" Value="NG"/>
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="NoActual">
                                                                <Setter Property="Text" Value="---"/>
                                                                <Setter Property="Foreground" Value="#E65100"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- 項目名 -->
                                            <TextBlock Grid.Column="1" Text="{Binding ItemName}"
                                                       FontSize="10" Foreground="#333333"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <!-- 期待値 (ベースライン) -->
                                            <TextBlock Grid.Column="2" Text="{Binding Expected}"
                                                       FontSize="9" Foreground="#888888"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="4,0,0,0"/>

                                            <!-- 実測値 -->
                                            <TextBlock Grid.Column="3" FontSize="9" Margin="4,0,0,0"
                                                       Text="{Binding Actual}"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#888888"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Mismatch">
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ============================================ -->
                            <!-- セクション: ベースライン突合 — インストール済みアプリ -->
                            <!-- ============================================ -->
                            <TextBlock Text="BASELINE — INSTALLED APPS"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#757B82"
                                       Margin="0,8,0,4"
                                       Visibility="{Binding IsBaselineLoaded, Converter={StaticResource BoolToVis}}"/>

                            <!-- サマリ行: 一致件数 / ベースライン総数 / 対象PC総数 -->
                            <TextBlock FontSize="9" Foreground="#555555" Margin="0,0,0,4"
                                       Visibility="{Binding IsBaselineLoaded, Converter={StaticResource BoolToVis}}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="一致: {0}件 / ベースライン: {1}件 / 対象PC: {2}件 / 差分: {3}件">
                                        <Binding Path="CurrentBaselineReport.InstalledAppsComparison.MatchCount" FallbackValue="0"/>
                                        <Binding Path="CurrentBaselineReport.InstalledAppsComparison.TotalBaselineCount" FallbackValue="0"/>
                                        <Binding Path="CurrentBaselineReport.InstalledAppsComparison.TotalActualCount" FallbackValue="0"/>
                                        <Binding Path="CurrentBaselineReport.InstalledAppsComparison.MismatchCount" FallbackValue="0"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                            <!-- 差分0件の場合 -->
                            <TextBlock Text="すべてのアプリが一致しています"
                                       FontSize="9" Foreground="#2E7D32" FontWeight="Bold"
                                       Margin="0,0,0,4"
                                       Visibility="{Binding CurrentBaselineReport.InstalledAppsComparison.AllMatch, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>

                            <!-- 差分リスト (Mismatch / Missing のみ) -->
                            <ItemsControl ItemsSource="{Binding CurrentBaselineReport.InstalledAppsComparison.Items}"
                                          Margin="0,0,0,6"
                                          Visibility="{Binding IsBaselineLoaded, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 判定バッジ -->
                                            <TextBlock Grid.Column="0" FontSize="9" FontWeight="Bold"
                                                       Margin="0,0,6,0" MinWidth="28">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="OK"/>
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Mismatch">
                                                                <Setter Property="Text" Value="NG"/>
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="NoActual">
                                                                <Setter Property="Text" Value="---"/>
                                                                <Setter Property="Foreground" Value="#E65100"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="NoExpected">
                                                                <Setter Property="Text" Value="NEW"/>
                                                                <Setter Property="Foreground" Value="#1565C0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- アプリ名 -->
                                            <TextBlock Grid.Column="1" Text="{Binding ItemName}"
                                                       FontSize="10" Foreground="#333333"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <!-- 期待値 (ベースラインバージョン) -->
                                            <TextBlock Grid.Column="2" Text="{Binding Expected}"
                                                       FontSize="9" Foreground="#888888"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="4,0,0,0"/>

                                            <!-- 実測値 -->
                                            <TextBlock Grid.Column="3" FontSize="9" Margin="4,0,0,0"
                                                       Text="{Binding Actual}"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#888888"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Mismatch">
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ============================================ -->
                            <!-- セクション: ベースライン突合 — 実行サマリ -->
                            <!-- ============================================ -->
                            <TextBlock Text="BASELINE — EXECUTION SUMMARY"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#757B82"
                                       Margin="0,8,0,4"
                                       Visibility="{Binding IsBaselineLoaded, Converter={StaticResource BoolToVis}}"/>

                            <ItemsControl ItemsSource="{Binding CurrentBaselineReport.Items}"
                                          Margin="0,0,0,6"
                                          Visibility="{Binding IsBaselineLoaded, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 判定バッジ -->
                                            <TextBlock Grid.Column="0" FontSize="9" FontWeight="Bold"
                                                       Margin="0,0,6,0" MinWidth="28">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="OK"/>
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MatchStatus}" Value="Mismatch">
                                                                <Setter Property="Text" Value="NG"/>
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MatchStatus}" Value="MissingInActual">
                                                                <Setter Property="Text" Value="MISS"/>
                                                                <Setter Property="Foreground" Value="#E65100"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MatchStatus}" Value="ExtraInActual">
                                                                <Setter Property="Text" Value="EXTRA"/>
                                                                <Setter Property="Foreground" Value="#666666"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- モジュール名 -->
                                            <TextBlock Grid.Column="1" Text="{Binding ModuleName}"
                                                       FontSize="10" Foreground="#333333"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <!-- 期待ステータス -->
                                            <TextBlock Grid.Column="2" Text="{Binding ExpectedStatus}"
                                                       FontSize="9" Foreground="#888888"
                                                       Margin="4,0,0,0"/>

                                            <!-- 実測ステータス (不一致時は赤) -->
                                            <TextBlock Grid.Column="3" FontSize="9" Margin="4,0,0,0"
                                                       Text="{Binding ActualStatus}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#888888"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MatchStatus}" Value="Mismatch">
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MatchStatus}" Value="MissingInActual">
                                                                <Setter Property="Foreground" Value="#E65100"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

        </DockPanel>

        <!-- ================================================================ -->
        <!-- Row 3: アクションボタン -->
        <!-- ================================================================ -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="12,4,12,4">

            <Button Content="納品データ出力"
                    Command="{Binding ExportDeliveryCommand}"
                    Padding="20,8"
                    FontWeight="SemiBold"
                    FontSize="14"/>
        </StackPanel>

        <!-- ================================================================ -->
        <!-- Row 4: ステータスバー (LED + ProgressBar + Message) -->
        <!-- ================================================================ -->
        <Border Grid.Row="4"
                Background="#4A4A4A"
                BorderBrush="#757B82"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- プログレスバー (読み込み中のみ表示) -->
                <ProgressBar Grid.Row="0"
                             IsIndeterminate="True"
                             Height="3"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                             Margin="0,0,0,6"/>

                <!-- LED + ステータスメッセージ -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LINK/ACT LED インジケータ -->
                    <Ellipse x:Name="LinkActLed"
                             Grid.Column="0"
                             Width="8" Height="8"
                             Fill="#00FF00"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#00FF00"
                                              BlurRadius="8"
                                              ShadowDepth="0"
                                              Opacity="0.7"/>
                        </Ellipse.Effect>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="LedBlink">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="1.0" To="0.15"
                                                        Duration="0:0:0.5"
                                                        AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="LedBlink"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Grid.Column="1"
                               Text="LINK/ACT"
                               FontSize="9"
                               Foreground="#AAAAAA"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>

                    <!-- ステータスメッセージ -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="#CCCCCC"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>
