<Window x:Class="FabriqEvidenceManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Fabriq Evidence Manager"
        Height="700" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#D4D0C8">

    <Window.Resources>
        <!-- Bool → Visibility 変換 -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ============================================================ -->
        <!-- CentreCOM テーマ: Button (明るい筐体に馴染むパーツ風) -->
        <!-- ============================================================ -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#C0BCB4"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#8E8B82"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D0CCC4"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4CAF50"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#AAA69E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#388E3C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CCCAC4"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#B0ADA6"/>
                                <Setter Property="Foreground" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ -->
        <!-- CentreCOM テーマ: TextBox -->
        <!-- ============================================================ -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#8E8B82"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="Black"/>
            <Setter Property="SelectionBrush" Value="#4CAF50"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <!-- ============================================================ -->
        <!-- CentreCOM テーマ: TextBlock (デフォルト) -->
        <!-- ============================================================ -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- ============================================================ -->
        <!-- CentreCOM テーマ: GroupBox -->
        <!-- ============================================================ -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#8E8B82"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- ============================================================ -->
        <!-- CentreCOM テーマ: DataGrid -->
        <!-- ============================================================ -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#ECEAE4"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#8E8B82"/>
            <Setter Property="RowBackground" Value="#F5F4F0"/>
            <Setter Property="AlternatingRowBackground" Value="#ECEAE4"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#C8C4BC"/>
            <Setter Property="VerticalGridLinesBrush" Value="#C8C4BC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        </Style>

        <!-- DataGrid ColumnHeader -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#B8B4AC"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#8E8B82"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- DataGrid Cell -->
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#C8C4BC"/>
            <Setter Property="BorderThickness" Value="0,0,0,0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4CAF50"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#388E3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================ -->
        <!-- CentreCOM テーマ: ProgressBar (ネットワーク風グリーン) -->
        <!-- ============================================================ -->
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#C8C4BC"/>
            <Setter Property="Foreground" Value="#4CAF50"/>
            <Setter Property="BorderBrush" Value="#8E8B82"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </Window.Resources>

    <!-- ================================================================ -->
    <!-- メインレイアウト -->
    <!-- ================================================================ -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: ヘッダーバー (ロゴ + 青黄赤ストライプ) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Evidence フォルダ選択 -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: DataGrid (メインコンテンツ) -->
            <RowDefinition Height="*"/>
            <!-- Row 3: アクションボタン -->
            <RowDefinition Height="Auto"/>
            <!-- Row 4: ステータスバー -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================================================================ -->
        <!-- Row 0: ヘッダーバー — ロゴ + CentreCOM 青黄赤ストライプ -->
        <!-- ================================================================ -->
        <StackPanel Grid.Row="0" Background="#4A4A4A">
            <!-- ロゴ / 製品名 -->
            <Grid Margin="16,10,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FABRIQ"
                               FontSize="22" FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  EVIDENCE MANAGER"
                               FontSize="22" FontWeight="Light"
                               Foreground="#CCCCCC"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- (右端スペーサー) -->
            </Grid>

            <!-- Allied Telesis 風 3色ストライプ (青・黄・赤、上から下へ横線3本) -->
            <StackPanel Orientation="Vertical">
                <Rectangle Height="2" Fill="#4A90D9" HorizontalAlignment="Stretch"/>
                <Rectangle Height="2" Fill="#F2C94C" HorizontalAlignment="Stretch"/>
                <Rectangle Height="2" Fill="#EB5757" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </StackPanel>

        <!-- ================================================================ -->
        <!-- Row 1: Evidence フォルダ選択 -->
        <!-- ================================================================ -->
        <GroupBox Grid.Row="1" Header="Evidence フォルダ" Margin="12,8,12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding EvidenceRootPath, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         IsReadOnly="True"/>

                <Button Grid.Column="1"
                        Content="参照..."
                        Command="{Binding SelectEvidenceFolderCommand}"
                        Margin="6,0,0,0"/>

                <Button Grid.Column="2"
                        Content="読み込み"
                        Command="{Binding LoadEvidenceCommand}"
                        Margin="6,0,0,0"
                        FontWeight="SemiBold"/>
            </Grid>
        </GroupBox>

        <!-- ================================================================ -->
        <!-- Row 2: 検索バー + DataGrid — PC情報一覧 -->
        <!-- ================================================================ -->
        <DockPanel Grid.Row="2" Margin="12,4,12,4">

            <!-- 検索ボックス (上部に固定) -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="FILTER:"
                           FontSize="11" FontWeight="Bold"
                           Foreground="#555555"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"/>
            </Grid>

            <!-- DataGrid + GridSplitter + Preview Panel -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="400" MinWidth="250"/>
                </Grid.ColumnDefinitions>

                <!-- DataGrid (左) -->
                <DataGrid Grid.Column="0"
                      ItemsSource="{Binding TargetPCsView}"
                      SelectedItem="{Binding SelectedPc}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      ClipboardCopyMode="IncludeHeader"
                      HeadersVisibility="Column"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">

                    <!-- 警告行ハイライト (HasWarning=True → 薄い赤背景) -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                    <Setter Property="Background" Value="#FFCDD2"/>
                                </DataTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="#DDD9D0"/>
                                </MultiTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <!-- PC名 -->
                        <DataGridTextColumn Header="PC名"
                                            Binding="{Binding PcName}"
                                            MinWidth="100"
                                            Width="SizeToCells">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#222222"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- シリアルナンバー -->
                        <DataGridTextColumn Header="シリアル"
                                            Binding="{Binding SerialNumber}"
                                            MinWidth="120"
                                            Width="SizeToCells"/>

                        <!-- イーサネットMAC -->
                        <DataGridTextColumn Header="MAC (イーサネット)"
                                            Binding="{Binding EthernetMac}"
                                            MinWidth="140"
                                            Width="SizeToCells"/>

                        <!-- Wi-Fi MAC -->
                        <DataGridTextColumn Header="MAC (Wi-Fi)"
                                            Binding="{Binding WifiMac}"
                                            MinWidth="140"
                                            Width="SizeToCells"/>

                        <!-- BitLocker ドライブ -->
                        <DataGridTextColumn Header="BitLocker"
                                            Binding="{Binding BitLockerDrives}"
                                            MinWidth="70"
                                            Width="SizeToCells"/>

                        <!-- 検出状況 -->
                        <DataGridTextColumn Header="検出エビデンス"
                                            Binding="{Binding DetectedItems}"
                                            MinWidth="120"
                                            Width="SizeToCells"/>

                        <!-- ステータス (警告メッセージ) -->
                        <DataGridTextColumn Header="ステータス"
                                            Binding="{Binding WarningMessage}"
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#C62828"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="TextWrapping" Value="NoWrap"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- GridSplitter (ドラッグでプレビュー幅を調整) -->
                <GridSplitter Grid.Column="1"
                              Width="5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              Background="#B8B4AC"
                              Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}"/>

                <!-- プレビューパネル (右, SelectedPc != null 時のみ表示) -->
                <Border Grid.Column="2"
                        BorderBrush="#8E8B82"
                        BorderThickness="1,0,0,0"
                        Background="#E8E6E0"
                        Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8">
                        <StackPanel>

                            <!-- PC名ヘッダー -->
                            <TextBlock Text="{Binding SelectedPc.PcName}"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="#222222"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding SelectedPc.SerialNumber}"
                                       FontSize="12"
                                       Foreground="#666666"
                                       Margin="0,0,0,10"/>

                            <!-- セクション: キャプチャプレビュー -->
                            <TextBlock Text="AUTO CAPTURE"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#8E8B82"
                                       Margin="0,0,0,4"/>
                            <Border BorderBrush="#8E8B82" BorderThickness="1"
                                    Background="#333333" MinHeight="180"
                                    Margin="0,0,0,4">
                                <Grid>
                                    <!-- 画像あり -->
                                    <Image Source="{Binding CurrentPreviewImagePath}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <!-- 画像なし時のプレースホルダ -->
                                    <TextBlock Text="No Image"
                                               FontSize="14"
                                               Foreground="#777777"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentPreviewImagePath}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- ナビゲーション (前へ / カウンター / 次へ) -->
                            <Grid Margin="0,0,0,12"
                                  Visibility="{Binding HasMultipleImages, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="&lt; 前へ"
                                        Command="{Binding PreviousPreviewImageCommand}"
                                        Padding="10,3" FontSize="11"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding PreviewCounterText}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#555555"/>

                                <Button Grid.Column="2"
                                        Content="次へ &gt;"
                                        Command="{Binding NextPreviewImageCommand}"
                                        Padding="10,3" FontSize="11"/>
                            </Grid>

                            <!-- セクション: エビデンス詳細 -->
                            <TextBlock Text="EVIDENCE DETAILS"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#8E8B82"
                                       Margin="0,0,0,6"/>

                            <!-- MAC (有線) -->
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="有線 MAC:" FontSize="11" Foreground="#666666"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedPc.EthernetMac}" FontSize="11" FontFamily="Consolas"/>
                            </Grid>

                            <!-- MAC (Wi-Fi) -->
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Wi-Fi MAC:" FontSize="11" Foreground="#666666"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedPc.WifiMac}" FontSize="11" FontFamily="Consolas"/>
                            </Grid>

                            <!-- BitLocker -->
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="BitLocker:" FontSize="11" Foreground="#666666"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedPc.BitLockerDrives}" FontSize="11"/>
                            </Grid>

                            <!-- チェックリスト -->
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Checklist:" FontSize="11" Foreground="#666666"/>
                                <TextBlock Grid.Column="1" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding ChecklistFileName}"/>
                                            <Setter Property="Foreground" Value="#333333"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ChecklistFileName}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="未検出"/>
                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- 警告メッセージ -->
                            <Border Margin="0,10,0,0" Padding="8,6"
                                    Background="#FFF3E0" BorderBrush="#E65100" BorderThickness="1"
                                    Visibility="{Binding SelectedPc.HasWarning, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SelectedPc.WarningMessage}"
                                           FontSize="11" Foreground="#E65100"
                                           TextWrapping="Wrap"/>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

        </DockPanel>

        <!-- ================================================================ -->
        <!-- Row 3: アクションボタン -->
        <!-- ================================================================ -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="12,4,12,4">

            <Button Content="納品データ出力"
                    Command="{Binding ExportDeliveryCommand}"
                    Padding="20,8"
                    FontWeight="SemiBold"
                    FontSize="14"/>
        </StackPanel>

        <!-- ================================================================ -->
        <!-- Row 4: ステータスバー (LED + ProgressBar + Message) -->
        <!-- ================================================================ -->
        <Border Grid.Row="4"
                Background="#4A4A4A"
                BorderBrush="#8E8B82"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- プログレスバー (読み込み中のみ表示) -->
                <ProgressBar Grid.Row="0"
                             IsIndeterminate="True"
                             Height="3"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                             Margin="0,0,0,6"/>

                <!-- LED + ステータスメッセージ -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LINK/ACT LED インジケータ -->
                    <Ellipse x:Name="LinkActLed"
                             Grid.Column="0"
                             Width="8" Height="8"
                             Fill="#00FF00"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#00FF00"
                                              BlurRadius="8"
                                              ShadowDepth="0"
                                              Opacity="0.7"/>
                        </Ellipse.Effect>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="LedBlink">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="1.0" To="0.15"
                                                        Duration="0:0:0.5"
                                                        AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="LedBlink"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Grid.Column="1"
                               Text="LINK/ACT"
                               FontSize="9"
                               Foreground="#AAAAAA"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>

                    <!-- ステータスメッセージ -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="#CCCCCC"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>
