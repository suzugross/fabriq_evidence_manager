                                    <TextBlock Grid.Column="1" Text="{Binding SelectedPc.DomainStatus.DomainRole}" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
