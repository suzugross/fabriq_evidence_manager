<Window x:Class="FabriqEvidenceManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Fabriq Evidence Manager"
        Height="700" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#BABEc2">

    <Window.Resources>
        <!-- Bool → Visibility 変換 -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ============================================================ -->
        <!-- CentreCOM テーマ: Button (明るい筐体に馴染むパーツ風) -->
        <!-- ============================================================ -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#989DA1"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#757B82"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#AAAEB3"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4CAF50"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#84898E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#388E3C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#B2B6BA"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94989C"/>
                                <Setter Property="Foreground" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ -->
        <!-- CentreCOM テーマ: TextBox -->
        <!-- ============================================================ -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#757B82"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="Black"/>
            <Setter Property="SelectionBrush" Value="#4CAF50"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <!-- ============================================================ -->
        <!-- CentreCOM テーマ: TextBlock (デフォルト) -->
        <!-- ============================================================ -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2C2C2C"/>
        </Style>

        <!-- ============================================================ -->
        <!-- CentreCOM テーマ: GroupBox -->
        <!-- ============================================================ -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#2C2C2C"/>
            <Setter Property="BorderBrush" Value="#757B82"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- ============================================================ -->
        <!-- CentreCOM テーマ: DataGrid -->
        <!-- ============================================================ -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#E1E4E7"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#757B82"/>
            <Setter Property="RowBackground" Value="#EDEEEF"/>
            <Setter Property="AlternatingRowBackground" Value="#E1E4E7"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#A4A8AD"/>
            <Setter Property="VerticalGridLinesBrush" Value="#A4A8AD"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        </Style>

        <!-- DataGrid ColumnHeader -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#A0A6AB"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#757B82"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- DataGrid Cell -->
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#A4A8AD"/>
            <Setter Property="BorderThickness" Value="0,0,0,0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4CAF50"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#388E3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================ -->
        <!-- CentreCOM テーマ: ProgressBar (ネットワーク風グリーン) -->
        <!-- ============================================================ -->
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#A4A8AD"/>
            <Setter Property="Foreground" Value="#4CAF50"/>
            <Setter Property="BorderBrush" Value="#757B82"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </Window.Resources>

    <!-- ================================================================ -->
    <!-- メインレイアウト -->
    <!-- ================================================================ -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: ヘッダーバー (ロゴ + 青黄赤ストライプ) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Evidence フォルダ選択 -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: DataGrid (メインコンテンツ) -->
            <RowDefinition Height="*"/>
            <!-- Row 3: アクションボタン -->
            <RowDefinition Height="Auto"/>
            <!-- Row 4: ステータスバー -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================================================================ -->
        <!-- Row 0: ヘッダーバー — ロゴ + CentreCOM 青黄赤ストライプ -->
        <!-- ================================================================ -->
        <StackPanel Grid.Row="0" Background="#4A4A4A">
            <!-- ロゴ / 製品名 -->
            <Grid Margin="16,10,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FABRIQ"
                               FontSize="22" FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  EVIDENCE MANAGER"
                               FontSize="22" FontWeight="Light"
                               Foreground="#CCCCCC"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- (右端スペーサー) -->
            </Grid>

            <!-- Allied Telesis 風 3色ストライプ (青・黄・赤、上から下へ横線3本) -->
            <StackPanel Orientation="Vertical">
                <Rectangle Height="2" Fill="#4A90D9" HorizontalAlignment="Stretch"/>
                <Rectangle Height="2" Fill="#F2C94C" HorizontalAlignment="Stretch"/>
                <Rectangle Height="2" Fill="#EB5757" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </StackPanel>

        <!-- ================================================================ -->
        <!-- Row 1: Evidence フォルダ選択 -->
        <!-- ================================================================ -->
        <GroupBox Grid.Row="1" Header="Evidence フォルダ" Margin="12,8,12,4">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding EvidenceRootPath, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             IsReadOnly="True"/>

                    <Button Grid.Column="1"
                            Content="参照..."
                            Command="{Binding SelectEvidenceFolderCommand}"
                            Margin="6,0,0,0"/>

                    <Button Grid.Column="2"
                            Content="読み込み"
                            Command="{Binding LoadEvidenceCommand}"
                            Margin="6,0,0,0"
                            FontWeight="SemiBold"/>

                    <!-- 自動更新トグル -->
                    <CheckBox Grid.Column="3"
                              Content="自動更新 (30秒)"
                              IsChecked="{Binding IsAutoReloadEnabled}"
                              VerticalAlignment="Center"
                              Foreground="#2C2C2C"
                              FontSize="11"
                              Margin="10,0,0,0"/>
                </Grid>
            <!-- hostlist 読み込み -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Hostlist:"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="#2C2C2C"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBox Grid.Column="1"
                         Text="{Binding HostlistPath, Mode=OneWay}"
                         VerticalContentAlignment="Center"
                         IsReadOnly="True"
                         FontSize="11"/>

                <Button Grid.Column="2"
                        Content="CSV 読込..."
                        Command="{Binding LoadHostlistCommand}"
                        Margin="6,0,0,0"
                        FontSize="12"/>

                <TextBlock Grid.Column="3"
                           Text="{Binding HostlistStatusText}"
                           FontSize="11"
                           Foreground="#555555"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </Grid>
            <!-- ベースラインPC設定 -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Baseline PC:"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="#2C2C2C"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding BaselineStatusText}"
                           FontSize="11"
                           Foreground="#555555"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        Content="選択PCをベースラインに設定"
                        Command="{Binding SetBaselinePcCommand}"
                        Margin="6,0,0,0"
                        FontSize="12"/>

                <Button Grid.Column="3"
                        Content="クリア"
                        Command="{Binding ClearBaselineCommand}"
                        Margin="6,0,0,0"
                        FontSize="12"/>
            </Grid>
            </StackPanel>
        </GroupBox>

        <!-- ================================================================ -->
        <!-- Row 2: 検索バー + DataGrid — PC情報一覧 -->
        <!-- ================================================================ -->
        <DockPanel Grid.Row="2" Margin="12,4,12,4">

            <!-- エビデンス取得チェック項目 -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="取得チェック:"
                           FontSize="11" FontWeight="Bold"
                           Foreground="#555555"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <CheckBox Content="MAC(有線)"
                          IsChecked="{Binding CheckOptions.CheckEthernetMac}"
                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                <CheckBox Content="MAC(Wi-Fi)"
                          IsChecked="{Binding CheckOptions.CheckWifiMac}"
                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                <CheckBox Content="BitLocker"
                          IsChecked="{Binding CheckOptions.CheckBitLocker}"
                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                <CheckBox Content="PC情報"
                          IsChecked="{Binding CheckOptions.CheckPcInformation}"
                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                <CheckBox Content="キャプチャ"
                          IsChecked="{Binding CheckOptions.CheckAutoCapture}"
                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                <CheckBox Content="チェックリスト"
                          IsChecked="{Binding CheckOptions.CheckChecklist}"
                          VerticalAlignment="Center" Margin="0,0,20,0"/>

                <TextBlock Text="|" Foreground="#999999" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="突合:"
                           FontSize="11"
                           Foreground="#555555"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <CheckBox Content="余剰プリンタ検出"
                          IsChecked="{Binding CheckOptions.CheckExtraPrinters}"
                          VerticalAlignment="Center" Margin="0,0,12,0"/>
            </StackPanel>

            <!-- 検索ボックス (上部に固定) -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="FILTER:"
                           FontSize="11" FontWeight="Bold"
                           Foreground="#555555"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding DisplayCountText}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#555555"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </Grid>

            <!-- DataGrid + GridSplitter + Preview Panel -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="400" MinWidth="250"/>
                </Grid.ColumnDefinitions>

                <!-- DataGrid (左) -->
                <DataGrid Grid.Column="0"
                      ItemsSource="{Binding TargetPCsView}"
                      SelectedItem="{Binding SelectedPc}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      ClipboardCopyMode="IncludeHeader"
                      HeadersVisibility="Column"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">

                    <!-- 行ハイライト: HasCaution=黄, HasWarning=赤 (赤が優先) -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCaution}" Value="True">
                                    <Setter Property="Background" Value="#FFF9C4"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                    <Setter Property="Background" Value="#FFCDD2"/>
                                </DataTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="#D2D4D9"/>
                                </MultiTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <!-- 計画 PC 名 (hostlist で選択された名前 = manifest.selectedNewPcName) -->
                        <DataGridTextColumn Header="計画 PC 名"
                                            Binding="{Binding PcName}"
                                            MinWidth="100"
                                            Width="SizeToCells">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#222222"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 実 PC 名 (manifest.computerName = $env:COMPUTERNAME / rename 後の現在の名前) -->
                        <DataGridTextColumn Header="実 PC 名"
                                            Binding="{Binding ActualComputerNameDisplay}"
                                            MinWidth="100"
                                            Width="SizeToCells">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#222222"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPcNameMismatch}" Value="True">
                                            <Setter Property="Foreground" Value="#C62828"/>
                                            <Setter Property="Background" Value="#FCE4EC"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- シリアルナンバー (採用ソース併記。フォールバック取得時は黄色強調) -->
                        <DataGridTextColumn Header="シリアル"
                                            Binding="{Binding SerialNumberDisplay}"
                                            MinWidth="160"
                                            Width="SizeToCells">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSerialFallbackWarning}" Value="True">
                                            <Setter Property="Foreground" Value="#E65100"/>
                                            <Setter Property="Background" Value="#FFF3E0"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 収集日 -->
                        <DataGridTextColumn Header="収集日"
                                            Binding="{Binding CollectionDate}"
                                            MinWidth="90"
                                            Width="SizeToCells"/>

                        <!-- イーサネットMAC -->
                        <DataGridTextColumn Header="MAC (イーサネット)"
                                            Binding="{Binding EthernetMac}"
                                            MinWidth="140"
                                            Width="SizeToCells"/>

                        <!-- Wi-Fi MAC -->
                        <DataGridTextColumn Header="MAC (Wi-Fi)"
                                            Binding="{Binding WifiMac}"
                                            MinWidth="140"
                                            Width="SizeToCells"/>

                        <!-- BitLocker (ドライブレター + 回復キー併記、ItemsControl で行毎レイアウト) -->
                        <DataGridTemplateColumn Header="BitLocker (回復キー)"
                                                MinWidth="280"
                                                Width="SizeToCells">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding BitLockerKeys}" Margin="4,2">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontFamily="Consolas" FontSize="11">
                                                    <Run Text="{Binding DriveLetter, Mode=OneWay}" FontWeight="Bold"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding RecoveryPassword, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 検出状況 -->
                        <DataGridTextColumn Header="検出エビデンス"
                                            Binding="{Binding DetectedItems}"
                                            MinWidth="120"
                                            Width="SizeToCells"/>

                        <!-- ステータス (警告 + 要確認メッセージ) -->
                        <DataGridTemplateColumn Header="ステータス" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" Margin="4,2">
                                        <TextBlock Text="{Binding WarningMessage}"
                                                   Foreground="#C62828"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding CautionMessage}"
                                                   Foreground="#E65100"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasCaution, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- GridSplitter (ドラッグでプレビュー幅を調整) -->
                <GridSplitter Grid.Column="1"
                              Width="5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              Background="#A0A6AB"
                              Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}"/>

                <!-- プレビューパネル (右, SelectedPc != null 時のみ表示) -->
                <Border Grid.Column="2"
                        BorderBrush="#757B82"
                        BorderThickness="1,0,0,0"
                        Background="#D2D6DB"
                        Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8">
                        <StackPanel>

                            <!-- 計画 PC 名ヘッダー -->
                            <TextBlock Text="{Binding SelectedPc.PcName}"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="#222222"
                                       Margin="0,0,0,2"/>

                            <!-- 実 PC 名 (manifest.computerName / 不一致時赤強調) -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="実: " FontSize="11" Foreground="#666666"/>
                                <TextBlock Text="{Binding SelectedPc.ActualComputerNameDisplay}" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#666666"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedPc.HasPcNameMismatch}" Value="True">
                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- シリアル (採用ソース併記。フォールバック取得時はオレンジ強調) -->
                            <TextBlock Text="{Binding SelectedPc.SerialNumberDisplay}"
                                       FontSize="12"
                                       Margin="0,0,0,10">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#666666"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPc.HasSerialFallbackWarning}" Value="True">
                                                <Setter Property="Foreground" Value="#E65100"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- セクション: キャプチャプレビュー -->
                            <TextBlock Text="AUTO CAPTURE"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#757B82"
                                       Margin="0,0,0,4"/>
                            <Border BorderBrush="#757B82" BorderThickness="1"
                                    Background="#2C2C2C" MinHeight="180"
                                    Margin="0,0,0,4">
                                <Grid>
                                    <!-- 画像あり -->
                                    <Image Source="{Binding CurrentPreviewImagePath}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <!-- 画像なし時のプレースホルダ -->
                                    <TextBlock Text="No Image"
                                               FontSize="14"
                                               Foreground="#777777"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentPreviewImagePath}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- ナビゲーション (前へ / カウンター / 次へ) -->
                            <Grid Margin="0,0,0,12"
                                  Visibility="{Binding HasMultipleImages, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="&lt; 前へ"
                                        Command="{Binding PreviousPreviewImageCommand}"
                                        Padding="10,3" FontSize="11"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding PreviewCounterText}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#555555"/>

                                <Button Grid.Column="2"
                                        Content="次へ &gt;"
                                        Command="{Binding NextPreviewImageCommand}"
                                        Padding="10,3" FontSize="11"/>
                            </Grid>

                            <!-- セクション: エビデンス詳細 -->
                            <TextBlock Text="EVIDENCE DETAILS"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#757B82"
                                       Margin="0,0,0,6"/>

                            <!-- MAC (有線) -->
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="有線 MAC:" FontSize="11" Foreground="#666666"/>
